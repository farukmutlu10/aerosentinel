# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
out-tsc/
*.tsbuildinfo

# Generated code (regenerated from OpenAPI spec)
#lib/api-client-react/src/generated/
#lib/api-zod/src/generated/

# Environment files (contain secrets)
.env
.env.local
.env.production

# Lock files
pnpm-lock.yaml

# IDE / Editor
.vscode/
.idea/
*.sublime-workspace

# OS files
.DS_Store
Thumbs.db

# Logs
*.log
logs/

