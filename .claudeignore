.cache/
.local/
.replit-artifact/

# Attached assets (HTML mockups, font archives, design files)
attached_assets/

# Wrangler
.wrangler/

# Build scripts output
scripts/dist/

# Brand kit (binary assets)
brand-kit/icons/
brand-kit/fonts/

# Public static assets (binary — not useful for code context)
artifacts/aero-sentinel/public/*.png
artifacts/aero-sentinel/public/*.jpg
artifacts/aero-sentinel/public/*.woff2
artifacts/aero-sentinel/public/*.ttf
artifacts/aero-sentinel/public/*.xml
artifacts/aero-sentinel/public/fonts/

